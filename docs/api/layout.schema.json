{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trellis layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "windows"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "windows": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/window"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "launch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "shell"
            },
            "directory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hostId"
          ],
          "properties": {
            "kind": {
              "const": "host"
            },
            "hostId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/pane"
        },
        {
          "$ref": "#/$defs/split"
        }
      ]
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "launch"
      ],
      "properties": {
        "type": {
          "const": "pane"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "launch": {
          "$ref": "#/$defs/launch"
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "axis",
        "ratio",
        "children"
      ],
      "properties": {
        "type": {
          "const": "split"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "root"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "root": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "tabs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      }
    }
  }
}
