{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trellis layout v3 (versions 1 and 2 still accepted)",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": [
        "version",
        "spaces"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "spaces": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/space"
          }
        }
      }
    },
    {
      "description": "Versions 1 and 2, read as version 3. A list named windows (the original version 1 spelling) is refused: rename it spaces.",
      "additionalProperties": false,
      "required": [
        "version",
        "spaces"
      ],
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "spaces": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/legacySpace"
          }
        }
      }
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "machine": {
      "description": "Where the space runs: this Mac, or a remote workspace on a saved host.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "local"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hostId"
          ],
          "properties": {
            "kind": {
              "const": "remote"
            },
            "hostId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "pane": {
      "description": "A pane. agent (an agent definition ID) is allowed only with a shell launch, whose directory the agent starts in.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key",
            "launch"
          ],
          "properties": {
            "type": {
              "const": "pane"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "launch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "shell"
                },
                "directory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "agent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key",
            "launch"
          ],
          "properties": {
            "type": {
              "const": "pane"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "launch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "hostId"
              ],
              "properties": {
                "kind": {
                  "const": "ssh"
                },
                "hostId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "axis",
        "ratio",
        "children"
      ],
      "properties": {
        "type": {
          "const": "split"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/pane"
        },
        {
          "$ref": "#/$defs/split"
        }
      ]
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "root"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "root": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "tabs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      }
    },
    "legacyLaunch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "shell"
            },
            "directory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hostId"
          ],
          "properties": {
            "kind": {
              "const": "host"
            },
            "hostId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "legacyNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyPane"
        },
        {
          "$ref": "#/$defs/legacySplit"
        }
      ]
    },
    "legacyPane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "launch"
      ],
      "properties": {
        "type": {
          "const": "pane"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "launch": {
          "$ref": "#/$defs/legacyLaunch"
        }
      }
    },
    "legacySplit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "axis",
        "ratio",
        "children"
      ],
      "properties": {
        "type": {
          "const": "split"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/legacyNode"
          }
        }
      }
    },
    "legacyTab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "root"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "root": {
          "$ref": "#/$defs/legacyNode"
        }
      }
    },
    "legacySpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "tabs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/legacyTab"
          }
        }
      },
      "description": "A space in a version 1 or 2 document: no machine, project or agents; host launches are read as ssh."
    }
  }
}
