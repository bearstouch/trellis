+
+    private func captureReflowCursor() {
+        cursorReflowAnchor = nil
+        cursorReflowDestination = nil
+        guard reflowCursorLine, isReflowEnabled, !lines.isEmpty else { return }
+        let row = min(lines.count - 1, yBase + y)
+        var first = row
+        while first > 0 && lines[first].isWrapped { first -= 1 }
+        cursorReflowAnchor = lines[first]
+        cursorReflowOffset = x
+        if first < row {
+            for index in first..<row {
+                cursorReflowOffset += getWrappedLineTrimmedLength(lines, index, cols)
+            }
+        }
+        cursorReflowPendingWrap = x == cols
+        cursorReflowDestination = (lines[row], x)
+    }
+
+    private func mapReflowCursor(_ group: [BufferLine], lengths: [Int], newCols: Int) {
+        guard let anchor = cursorReflowAnchor, group.first === anchor, !lengths.isEmpty else { return }
+        var offset = cursorReflowOffset
+        for index in lengths.indices {
+            let length = lengths[index]
+            if offset < length || index == lengths.count - 1
+                || (offset == length && cursorReflowPendingWrap && length == newCols) {
+                cursorReflowDestination = (group[index], min(newCols, offset))
+                return
+            }
+            offset -= length
+        }
+    }
+
+    private func restoreReflowCursor(newRows: Int, newCols: Int) {
+        defer { cursorReflowAnchor = nil; cursorReflowDestination = nil }
+        guard let destination = cursorReflowDestination else { return }
+        for row in 0..<lines.count where lines[row] === destination.line {
+            let following = yDisp == yBase
+            if row < yBase { yBase = row }
+            if row >= yBase + newRows { yBase = row - newRows + 1 }
+            if following { yDisp = yBase }
+            y = row - yBase
+            x = min(newCols, destination.column)
+            return
+        }
+    }
     
