{
  "version": 1,
  "tasks": [
    {
      "name": "build",
      "command": "swift build",
      "group": "build"
    },
    {
      "name": "test",
      "command": "swift test",
      "group": "test"
    },
    {
      "name": "lint",
      "command": "swift format lint --strict -r Sources Tests",
      "group": "test"
    },
    {
      "name": "format",
      "command": "swift format -i -r Sources Tests"
    },
    {
      "name": "run fixture",
      "command": "swift run Trellis --fixture",
      "group": "run"
    }
  ]
}
